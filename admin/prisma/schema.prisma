// DAMA CMS — phase 1: access (users, roles, sessions, invites, audit log).
// Content tables (projects, news, careers) arrive in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// ADMIN: users, settings, go live. EDITOR: create, edit, publish to preview. VIEWER: read only.
enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  name         String    @db.VarChar(120)
  passwordHash String    @db.VarChar(255)
  role         Role      @default(EDITOR)
  /// Disabled users cannot sign in; their sessions are revoked on disable.
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  auditLogs    AuditLog[]
  invitesSent  Invite[]  @relation("InvitedBy")
}

/// Only a SHA-256 hash of the session token is stored; the token itself lives in the cookie.
model Session {
  id        String   @id @db.VarChar(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(255)

  @@index([userId])
  @@index([expiresAt])
}

/// One-time invitation link. Stored as a hash; valid until accepted, revoked or expired.
model Invite {
  id          String    @id @default(cuid())
  email       String    @db.VarChar(191)
  role        Role
  tokenHash   String    @unique @db.VarChar(64)
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

/// Append-only record of who did what and when.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(64)
  entity    String?  @db.VarChar(64)
  entityId  String?  @db.VarChar(191)
  meta      Json?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

/// Sign-in attempts, used to rate-limit by email and by IP.
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  email     String   @db.VarChar(191)
  ip        String   @db.VarChar(64)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
